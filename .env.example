# Cloud Postgres connection string (Supabase, Neon, or local Docker)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bloodcare?sslmode=require"

# HMAC secret used to sign admin / user JWTs — generate a long random string
JWT_SECRET="replace-with-a-long-random-secret"

# HTTP port for the Express process
PORT=5000

# Browser origin(s) allowed by CORS. Comma-separate extra production URLs.
FRONTEND_URL="http://localhost:5173"
